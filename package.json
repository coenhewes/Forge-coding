{
  "name": "forge",
  "version": "0.0.1",
  "private": true,
  "description": "Long-horizon software engineering agent",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "forge": "node packages/forge-cli/dist/cli.js",
    "migrate": "node -r dotenv/config packages/forge-cli/dist/cli.js state migrate",
    "doctor": "node -r dotenv/config packages/forge-cli/dist/cli.js doctor",
    "doctor:migrate": "node -r dotenv/config packages/forge-cli/dist/cli.js doctor --migrate",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "postgres": "^3.4.5",
    "dotenv": "^16.4.5",
    "@forge/agent": "workspace:*",
    "@forge/cli": "workspace:*",
    "@forge/belief": "workspace:*",
    "@forge/verification-planner": "workspace:*",
    "@forge/tui": "workspace:*",
    "@forge/trace": "workspace:*",
    "@forge/provider": "workspace:*",
    "@forge/harness": "workspace:*",
    "@forge/repo-graph": "workspace:*",
    "@forge/repo-intel": "workspace:*",
    "@forge/context-server": "workspace:*",
    "@forge/state-store": "workspace:*",
    "@forge/integrations": "workspace:*",
    "@forge/vscode": "workspace:*",
    "@forge/types": "workspace:*",
    "@forge/state": "workspace:*",
    "@forge/verification": "workspace:*",
    "@forge/pr": "workspace:*",
    "@forge/eval": "workspace:*"
  }
}
