# Forge environment configuration
# Copy to .env and fill in real values. .env is gitignored.

# Required: Postgres connection for @forge/state-store.
FORGE_DATABASE_URL=postgres://forge:forge@localhost:54329/forge

# Provider keys (read by `forge providers test`). Optional — only needed
# for the providers you actually use.
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override default state directory (default: ~/.forge/state).
# FORGE_STATE_DIR=
