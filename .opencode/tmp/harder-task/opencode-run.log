test("burst of pipelined requests all get responses in order", async () => {
  const child = spawn("node", [SERVER_ENTRY], { stdio: ["pipe", "pipe", "pipe"] });
  let stdout = "";
  let stderr = "";
  child.stdout.setEncoding("utf8");
  child.stderr.setEncoding("utf8");
