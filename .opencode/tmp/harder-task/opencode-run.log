```ts
// Module-level state
let processingChain: Promise<void> = Promise.resolve();
let shutdownRequested = false;
let exited = false;

function enqueue(task: () => Promise<void> | void): void {
  // Append the task to the serial queue. Each task runs strictly after
  // the previous one settles, so requests are processed in arrival order
  // and each response is fully written before the next request begins.
  const next = processingChain.then(task, task);
  // Avoid unhandled-rejection warnings if a task throws.
  void next.catch(() => undefined);
  processingChain = next;
}

function scheduleExit(): void {
  if (exited) return;
  exited = true;
  // Wait for the queue to fully drain, then flush stdout, then exit.
  processingChain.then(
    () => {
      // Empty write + callback fires once stdout has drained to the OS.
      process.stdout.write("", () => {
        process.exit(0);
      });
    },
    () => {
      process.stdout.write("", () => {
        process.exit(0);
      });
    }
  );
}
```

